<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Checklist Inspeção</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChecklistInspecao.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var paginaAtual = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    }
    <header class="d-print-none">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-area="" asp-page="/Index">PassoCerto - Checklist Inspeção</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Abrir menu">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link @(paginaAtual == "/Index" ? "active" : "")"
                                asp-area="" asp-page="/Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(paginaAtual.StartsWith("/Lojas") ? "active" : "")"
                                asp-area="" asp-page="/Lojas/Index">Lojas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(paginaAtual is "/Inspecoes/Index" or "/Inspecoes/Detalhe" or "/Inspecoes/Preencher" ? "active" : "")"
                                asp-area="" asp-page="/Inspecoes/Index">Histórico</a>
                            </li>
                            @if (User.IsInRole(Perfis.Supervisor))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(paginaAtual == "/Inspecoes/Criar" ? "active" : "")"
                                    asp-area="" asp-page="/Inspecoes/Criar">Nova inspeção</a>
                                </li>
                            }
                        </ul>

                        <div class="d-flex align-items-center gap-3">
                            <span class="navbar-text">@User.Identity.Name</span>
                            <form method="post" asp-page="/Logout" class="m-0">
                                <button type="submit" class="btn btn-outline-light btn-sm">Sair</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted d-print-none">
        <div class="container">
            &copy; 2026 - PassoCerto
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>